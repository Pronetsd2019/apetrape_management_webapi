# Peach Payments (Checkout V2 / Embedded)
# Sandbox defaults shown — switch to live URLs for production.

PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=

# Auth: sandbox https://sandbox-dashboard.peachpayments.com
#       live    https://dashboard.peachpayments.com
PEACH_AUTH_URL=https://sandbox-dashboard.peachpayments.com

# Checkout API: sandbox https://testsecure.peachpayments.com
#               live    https://secure.peachpayments.com
PEACH_CHECKOUT_URL=https://testsecure.peachpayments.com

# Currency supported by your Peach channel (ZAR, USD, KES, MUR, GBP, EUR)
PEACH_CURRENCY=ZAR

# Allowlisted origin / HTTPS base that serves embed.php (must match Peach Dashboard allowlist)
PEACH_ORIGIN=https://apetrape.com
PEACH_EMBED_BASE_URL=https://apetrape.com/webapi

# Exact webhook URL configured in Peach Dashboard (used for HMAC verification)
PEACH_WEBHOOK_URL=https://apetrape.com/webapi/mobile/v1/payment/peach_webhook.php
PEACH_WEBHOOK_SECRET=

# Set to 1 only for local sandbox debugging without signature (never in production)
PEACH_WEBHOOK_SKIP_VERIFY=0
